{
  "name": "stryker-cxx",
  "version": "0.1.0",
  "description": "Standalone Stryker-style C++/ObjC++ mutation CLI and mutation-testing-elements adapter",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "src/",
    "python/",
    "docs/",
    "fixtures/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "stryker-cxx": "./bin/stryker-cxx.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "schema:check": "node scripts/check-config-schema.mjs",
    "validate:full-spec": "node scripts/validate-full-spec.mjs",
    "lint": "node scripts/lint.mjs",
    "release:dry-run": "npm publish --dry-run --provenance --access public",
    "start": "node bin/stryker-cxx.js"
  },
  "keywords": [
    "mutation-testing",
    "mutation-testing-elements",
    "stryker",
    "cpp"
  ],
  "repository": "https://github.com/anagnorisis2peripeteia/stryker-cxx.git",
  "author": "OpenClaw contributors"
}
