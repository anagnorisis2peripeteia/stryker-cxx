{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anagnorisis2peripeteia/stryker-cxx/schemas/stryker-cxx.report.schema.json",
  "title": "stryker-cxx report",
  "type": "object",
  "required": ["schemaVersion", "tool", "toolVersion", "totalMutants", "killed", "survived", "score", "commands", "execution", "summary", "mutants", "mutationTestingElements"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "stryker-cxx.report.v1" },
    "tool": { "const": "stryker-cxx" },
    "toolVersion": { "type": "string" },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "totalMutants": { "type": "integer", "minimum": 0 },
    "killed": { "type": "integer", "minimum": 0 },
    "survived": { "type": "integer", "minimum": 0 },
    "buildErrors": { "type": "integer", "minimum": 0 },
    "checkErrors": { "type": "integer", "minimum": 0 },
    "noCoverage": { "type": "integer", "minimum": 0 },
    "timeouts": { "type": "integer", "minimum": 0 },
    "ignored": { "type": "integer", "minimum": 0 },
    "thresholds": {
      "type": "object",
      "required": ["high", "low", "break", "status"],
      "properties": {
        "high": { "type": "number" },
        "low": { "type": "number" },
        "break": { "type": "number" },
        "status": { "enum": ["failed", "low", "acceptable", "high"] }
      }
    },
    "commands": {
      "type": "object",
      "required": ["build", "check", "test"],
      "properties": {
        "build": { "type": ["string", "null"] },
        "check": { "type": ["string", "null"] },
        "test": { "type": ["string", "null"] }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "path": { "type": ["string", "null"] },
        "hash": { "type": ["string", "null"] },
        "effective": { "type": "object" }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "executionMode": { "enum": ["source-overlay", "mutant-switch"] },
        "requestedExecutionMode": { "enum": ["source-overlay", "mutant-switch"] },
        "executionBackend": { "enum": ["auto", "source-overlay", "mutant-switch", "compiled-artifact", "llvm-switch"] },
        "requestedExecutionBackend": { "enum": ["auto", "source-overlay", "mutant-switch", "compiled-artifact", "llvm-switch"] },
        "executionBackendFallbackReason": { "type": ["string", "null"] },
        "artifactBackend": {
          "enum": ["source-overlay", "compiled-executable", "compiled-library", "compiled-object"]
        },
        "requestedArtifactBackend": {
          "enum": ["source-overlay", "compiled-executable", "compiled-library", "compiled-object"]
        },
        "artifactFallback": { "enum": ["none", "source-overlay"] },
        "artifactFallbackReason": { "type": ["string", "null"] },
        "analysis": {
          "type": "object",
          "properties": {
            "engine": { "type": "string" },
            "macroRejectedMutants": { "type": "integer", "minimum": 0 },
            "macroRejections": { "type": "array" },
            "sourcePrecision": { "type": "object" },
            "equivalentSuppression": {
              "type": "object",
              "properties": {
                "mode": { "enum": ["off", "conservative", "aggressive"] },
                "suppressedMutants": { "type": "integer", "minimum": 0 },
                "suppressions": { "type": "array" }
              }
            }
          }
        },
        "mutantSwitch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "requested": { "type": "boolean" },
            "fallbackReason": { "type": ["string", "null"] },
            "activationEnvironment": { "type": "string" },
            "runtimeGuardCount": { "type": "integer", "minimum": 0 },
            "candidateGuardCount": { "type": "integer", "minimum": 0 },
            "guards": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mutantId": { "type": "string" },
                  "guardId": { "type": "string" }
                }
              }
            },
            "artifactCandidate": { "type": "object" }
          }
        },
        "singleCompile": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "activationMethod": { "type": "string" },
            "activationEnvironment": { "type": "string" },
            "runtimeGuardCount": { "type": "integer", "minimum": 0 },
            "builds": { "type": "integer", "minimum": 0 },
            "checks": { "type": "integer", "minimum": 0 }
          }
        },
        "llvmSwitch": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "requested": { "type": "boolean" },
            "implementation": { "type": "string" },
            "fallbackReason": { "type": ["string", "null"] },
            "activationEnvironment": { "type": ["string", "null"] },
            "requires": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "dashboard": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "retentionDays": { "type": ["integer", "null"], "minimum": 1 },
            "exportPath": { "type": ["string", "null"] },
            "export": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": ["string", "null"] },
                "status": {
                  "type": "string",
                  "enum": ["disabled", "notAttempted", "writing", "succeeded", "failed"]
                },
                "bytes": { "type": ["integer", "null"], "minimum": 0 },
                "writtenAt": { "type": ["string", "null"] },
                "error": { "type": "string" }
              }
            },
            "upload": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "urlConfigured": { "type": "boolean" },
                "status": {
                  "type": "string",
                  "enum": ["disabled", "notAttempted", "attempting", "succeeded", "failed"]
                },
                "statusCode": { "type": "integer" },
                "error": { "type": "string" },
                "maxAttempts": { "type": "integer", "minimum": 0 },
                "retryDelayMs": { "type": "integer", "minimum": 0 },
                "attempts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "attempt": { "type": "integer", "minimum": 1 },
                      "status": {
                        "type": "string",
                        "enum": ["attempting", "succeeded", "failed"]
                      },
                      "statusCode": { "type": "integer" },
                      "error": { "type": "string" }
                    }
                  }
                },
                "authTokenEnv": { "type": ["string", "null"] },
                "authHeader": { "type": ["string", "null"] }
              }
            }
          }
        },
        "compilePruning": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "strategy": { "type": "string" },
            "candidateArtifactMode": { "type": "string" },
            "attempts": { "type": "integer", "minimum": 0 },
            "candidateMutants": { "type": "integer", "minimum": 0 },
            "failedBatches": { "type": "integer", "minimum": 0 },
            "retryBatches": { "type": "integer", "minimum": 0 },
            "prunedMutants": { "type": "integer", "minimum": 0 },
            "buildErrors": { "type": "integer", "minimum": 0 },
            "checkErrors": { "type": "integer", "minimum": 0 },
            "records": {
              "type": "array",
              "items": { "type": "object" }
            },
            "attemptRecords": {
              "type": "array",
              "items": { "type": "object" }
            },
            "retryRecords": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "testScheduler": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "string" },
            "strategy": { "type": "string" },
            "sessions": { "type": "integer", "minimum": 0 },
            "batchSessions": { "type": "integer", "minimum": 0 },
            "perMutantSessions": { "type": "integer", "minimum": 0 },
            "splitSessions": { "type": "integer", "minimum": 0 },
            "coverageSelectedSessions": { "type": "integer", "minimum": 0 },
            "groups": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "reporterMetadata": {
          "type": "array",
          "items": { "type": "object" }
        },
        "reporterRuns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "plugin": { "type": ["string", "null"] },
              "reporter": { "type": ["string", "null"] },
              "hook": { "type": ["string", "null"] },
              "phase": { "type": ["string", "null"] },
              "command": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] },
              "exitCode": { "type": ["integer", "null"] },
              "durationMs": { "type": ["integer", "null"], "minimum": 0 },
              "log": { "type": ["string", "null"] },
              "environment": { "type": ["object", "null"] },
              "reason": { "type": ["string", "null"] },
              "availableReporters": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "pluginLifecycle": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "string" },
            "supportedEvents": {
              "type": "array",
              "items": { "type": "string" }
            },
            "legacyAliases": { "type": "object" },
            "loadOrder": {
              "type": "array",
              "items": { "type": "string" }
            },
            "registeredHooks": {
              "type": "array",
              "items": { "type": "object" }
            },
            "runs": {
              "type": "array",
              "items": { "type": "object" }
            },
            "localOnly": { "type": "boolean" },
            "networkInstall": { "type": "boolean" }
          }
        },
        "resourceIsolation": {
          "type": "object",
          "properties": {
            "redaction": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "environmentValues": { "type": "boolean" },
                "secretAssignmentPatterns": { "type": "boolean" },
                "replacement": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "artifactModel": { "type": "string" },
        "phaseOrder": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "detail": { "type": "object" }
            }
          }
        }
      }
    },
    "projectAnalysis": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "confidence": { "type": "string" },
        "repo": { "type": "string" },
        "targetFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "buildSystems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "source": { "type": "string" },
              "confidence": { "type": "string" },
              "analysisKey": { "type": "string" }
            }
          }
        },
        "compileDatabase": { "type": "object" },
        "buildGraph": {
          "type": "object",
          "properties": {
            "schemaVersion": { "type": "string" },
            "confidence": { "type": "string" },
            "ownershipModel": { "type": "string" },
            "compileDatabase": { "type": "object" },
            "sourceNodes": {
              "type": "array",
              "items": { "type": "object" }
            },
            "buildTargetNodes": {
              "type": "array",
              "items": { "type": "object" }
            },
            "testTargetNodes": {
              "type": "array",
              "items": { "type": "object" }
            },
            "diagnostics": {
              "type": "array",
              "items": { "type": "object" }
            }
          }
        },
        "sourceTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "analysisKey": { "type": "string" },
              "ownership": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string" },
                  "source": { "type": "string" },
                  "confidence": { "type": "string" },
                  "key": { "type": "string" },
                  "buildTargets": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "buildTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "source": { "type": "string" },
              "confidence": { "type": "string" },
              "analysisKey": { "type": "string" },
              "sourceFiles": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "testTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "source": { "type": "string" },
              "confidence": { "type": "string" },
              "analysisKey": { "type": "string" },
              "relatedBuildTarget": { "type": "string" }
            }
          }
        },
        "commands": { "type": "object" }
      }
    },
    "mutationArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "mode": { "type": "string" },
        "backend": { "type": "string" },
        "implementation": { "type": "string" },
        "workspacePerMutant": { "type": "boolean" },
        "parallelSafe": { "type": "boolean" },
        "supportsCompiledReplacement": { "type": "boolean" },
        "workerTmpDir": { "type": "string" },
        "workerLabel": { "type": "string" },
        "retainArtifacts": { "type": "boolean" },
        "retainArtifactsFor": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sourceOverlay": {
          "type": "object",
          "properties": {
            "strategy": { "type": "string" },
            "restoration": { "type": "string" }
          }
        },
        "workRepo": { "type": "string" },
        "workspaceRoot": { "type": "string" },
        "retained": { "type": "boolean" },
        "retainedPath": { "type": "string" },
        "retainedReason": { "type": "string" }
      }
    },
    "artifactPlacement": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "mode": { "type": "string" },
        "implementation": { "type": "string" },
        "artifactRoot": { "type": ["string", "null"] },
        "workerTmpDir": { "type": ["string", "null"] },
        "workerLabel": { "type": ["string", "null"] },
        "restoreOriginals": { "type": "boolean" },
        "retainArtifacts": { "type": "boolean" },
        "retainArtifactsFor": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sourceOverlay": {
          "type": "object",
          "properties": {
            "restorePolicy": { "type": "string" },
            "placement": { "type": "string" }
          }
        },
        "compiledArtifacts": {
          "type": "object",
          "properties": {
            "supported": { "type": "boolean" },
            "placement": { "type": "string" },
            "restorePolicy": { "type": "string" }
          }
        },
        "workRepo": { "type": "string" },
        "workspaceRoot": { "type": "string" },
        "originalArtifactsRestored": { "type": "boolean" },
        "materializedArtifactRetained": { "type": "boolean" },
        "materializedArtifactRestored": { "type": "boolean" },
        "retainedPath": { "type": "string" },
        "retainedReason": { "type": "string" },
        "cleanupGuidance": { "type": "string" }
      }
    },
    "compiledArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": { "type": "string" },
          "backend": { "type": "string" },
          "kind": { "type": "string" },
          "target": { "type": "string" },
          "scratchRoot": { "type": "string" },
          "scratchRepo": { "type": "string" },
          "scratchBuildDir": { "type": "string" },
          "mutatedArtifact": { "type": ["string", "null"] },
          "originalArtifact": { "type": "string" },
          "backupArtifact": { "type": "string" },
          "placementPolicy": { "type": "string" },
          "restorationPolicy": { "type": "string" },
          "sourceCheckoutMutation": { "type": "boolean" },
          "originalHashBefore": { "type": ["string", "null"] },
          "originalHashAfter": { "type": ["string", "null"] },
          "originalRestored": { "type": "boolean" },
          "retained": { "type": "boolean" },
          "retainedPath": { "type": "string" },
          "cleanupGuidance": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["byStatus", "byFile", "byMutator"],
      "properties": {
        "byStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "byFile": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/summaryBucket" }
        },
        "byMutator": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/summaryBucket" }
        }
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "mutator", "status", "original", "mutated"],
        "properties": {
          "status": {
            "enum": ["KILLED", "SURVIVED", "BUILD_ERROR", "CHECK_ERROR", "NO_COVERAGE", "TIMEOUT", "IGNORED", "PENDING", "RUNTIME_ERROR"]
          }
        }
      }
    }
  },
  "$defs": {
    "summaryBucket": {
      "type": "object",
      "required": [
        "total",
        "killed",
        "survived",
        "buildErrors",
        "checkErrors",
        "noCoverage",
        "timeouts",
        "ignored",
        "runtimeErrors",
        "pending",
        "score"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "killed": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "buildErrors": { "type": "integer", "minimum": 0 },
        "checkErrors": { "type": "integer", "minimum": 0 },
        "noCoverage": { "type": "integer", "minimum": 0 },
        "timeouts": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "runtimeErrors": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
