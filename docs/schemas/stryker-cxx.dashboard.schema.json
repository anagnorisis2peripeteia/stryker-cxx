{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anagnorisis2peripeteia/stryker-cxx/schemas/stryker-cxx.dashboard.schema.json",
  "title": "stryker-cxx dashboard export",
  "type": "object",
  "required": [
    "schemaVersion",
    "dashboardVersion",
    "generatedAt",
    "tool",
    "toolVersion",
    "retention",
    "privacy",
    "provenance",
    "score",
    "thresholdStatus",
    "summary",
    "counts",
    "mutants"
  ],
  "properties": {
    "schemaVersion": { "const": "stryker-cxx.dashboard.v1" },
    "dashboardVersion": { "type": "string" },
    "generatedAt": { "type": "string" },
    "tool": { "const": "stryker-cxx" },
    "toolVersion": { "type": "string" },
    "repo": { "type": ["string", "null"] },
    "base": { "type": ["string", "null"] },
    "project": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "commit": { "type": ["string", "null"] },
    "runId": { "type": ["string", "null"] },
    "buildUrl": { "type": ["string", "null"] },
    "startedAt": { "type": "string" },
    "completedAt": { "type": ["string", "null"] },
    "retention": {
      "type": "object",
      "required": ["days", "policy"],
      "properties": {
        "days": { "type": ["integer", "null"], "minimum": 1 },
        "policy": { "type": "string" }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "sourceFilesIncluded",
        "mutantSourceSnippetsIncluded",
        "secretValuesRedacted",
        "environmentValuesRedacted"
      ],
      "properties": {
        "sourceFilesIncluded": { "type": "boolean" },
        "mutantSourceSnippetsIncluded": { "type": "boolean" },
        "secretValuesRedacted": { "type": "boolean" },
        "environmentValuesRedacted": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["reportSchemaVersion", "toolVersion", "configHash", "configPath", "ci", "upload"],
      "properties": {
        "reportSchemaVersion": { "type": "string" },
        "toolVersion": { "type": "string" },
        "configHash": { "type": ["string", "null"] },
        "configPath": { "type": ["string", "null"] },
        "ci": { "type": "object" },
        "upload": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "enabled": { "type": "boolean" },
            "urlConfigured": { "type": "boolean" },
            "status": {
              "type": "string",
              "enum": ["disabled", "notAttempted", "attempting", "succeeded", "failed"]
            },
            "statusCode": { "type": "integer" },
            "error": { "type": "string" },
            "authTokenEnv": { "type": ["string", "null"] },
            "authHeader": { "type": ["string", "null"] }
          }
        }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "thresholds": {
      "type": "object",
      "required": ["high", "low", "break", "status"],
      "properties": {
        "high": { "type": "number" },
        "low": { "type": "number" },
        "break": { "type": "number" },
        "status": { "enum": ["failed", "low", "acceptable", "high"] }
      }
    },
    "thresholdStatus": { "enum": ["failed", "low", "acceptable", "high", null] },
    "analysis": { "type": "object" },
    "projectAnalysis": { "type": "object" },
    "summary": { "type": "object" },
    "counts": { "type": "object" },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "mutator", "status"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "mutator": { "type": "string" },
          "status": { "type": "string" },
          "sourcePrecision": { "type": "object" }
        }
      }
    }
  }
}
